{
  "name": "supernova",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "turbo run dev --filter=@supernova/web --filter=@supernova/server",
    "dev:desktop": "turbo run dev --filter=@supernova/web --filter=@supernova/server --filter=@supernova/desktop",
    "start:server": "turbo run start --filter=@supernova/server",
    "start:desktop": "turbo run start --filter=@supernova/desktop",
    "build": "turbo run build",
    "package:desktop": "turbo run package:unpack --filter=@supernova/desktop --",
    "package:desktop:win": "turbo run package:win --filter=@supernova/desktop --",
    "package:desktop:mac": "turbo run package:mac --filter=@supernova/desktop --",
    "package:desktop:linux": "turbo run package:linux --filter=@supernova/desktop --",
    "lint": "turbo run lint && bun run lint:scripts",
    "lint:scripts": "eslint scripts",
    "prettier": "turbo run prettier && bun run prettier:scripts",
    "prettier:scripts": "prettier --check scripts --ignore-path .prettierignore",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @supernova/web test:e2e",
    "typecheck": "turbo run typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "prepare": "husky",
    "test:timeline": "bun run --filter @supernova/web test:timeline"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.2",
    "turbo": "^2.9.7"
  },
  "version": "1.0.0",
  "description": "<p align=\"center\">   <img src=\"packages/web/assets/icon.png\" alt=\"Supernova logo\" width=\"80\" /> </p>",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "@earendil-works/chord": "file:./vendor/pi/earendil-works-chord.tgz",
    "@earendil-works/pi-agent-core": "file:./vendor/pi/earendil-works-pi-agent-core.tgz",
    "@earendil-works/pi-ai": "file:./vendor/pi/earendil-works-pi-ai.tgz",
    "@earendil-works/pi-codemode": "file:./vendor/pi/earendil-works-pi-codemode.tgz",
    "@earendil-works/pi-coding-agent": "file:./vendor/pi/earendil-works-pi-coding-agent.tgz",
    "@earendil-works/pi-durable": "file:./vendor/pi/earendil-works-pi-durable.tgz",
    "@earendil-works/pi-mcp": "file:./vendor/pi/earendil-works-pi-mcp.tgz",
    "@earendil-works/pi-schema": "file:./vendor/pi/earendil-works-pi-schema.tgz",
    "@earendil-works/pi-telemetry": "file:./vendor/pi/earendil-works-pi-telemetry.tgz",
    "@earendil-works/pi-tui": "file:./vendor/pi/earendil-works-pi-tui.tgz"
  }
}
