{
  "name": "@supernova/contracts",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "exports": {
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    },
    "./services/*/services": {
      "types": "./src/services/*/services.ts",
      "import": "./src/services/*/services.ts"
    },
    "./services/*/procedures": {
      "types": "./src/services/*/procedures/index.ts",
      "import": "./src/services/*/procedures/index.ts"
    },
    "./services/*/schemas": {
      "types": "./src/services/*/schemas/index.ts",
      "import": "./src/services/*/schemas/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
