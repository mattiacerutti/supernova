{
  "name": "@supernova/agent-runtime",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "bun run test:unit && bun run test:integration",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "file:../../vendor/pi/earendil-works-chord.tgz",
    "@earendil-works/pi-ai": "file:../../vendor/pi/earendil-works-pi-ai.tgz",
    "@earendil-works/pi-coding-agent": "file:../../vendor/pi/earendil-works-pi-coding-agent.tgz",
    "@earendil-works/pi-durable": "file:../../vendor/pi/earendil-works-pi-durable.tgz",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@supernova/contracts": "workspace:*",
    "htmlparser2": "^12.0.0",
    "match-sorter": "^8.3.0",
    "turndown": "^7.2.4",
    "typebox": "1.3.27",
    "undici": "8.12.3",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.3.0",
    "eslint-plugin-check-file": "3.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.9"
  }
}
