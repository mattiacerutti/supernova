{
  "name": "@supernova/server",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "exports": {
    "./process": "./src/process.ts"
  },
  "bin": {
    "supernova-server": "./dist/cli.js"
  },
  "scripts": {
    "dev": "SUPERNOVA_SERVER_DEV=1 tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "build": "rm -rf dist && bun build src/cli.ts --define PI_BUNDLED_NODE=true --target node --external @lydell/node-pty --external @silvia-odwyer/photon-node --outdir dist && bun scripts/prepare-tools.ts",
    "test": "bun test tests",
    "lint": "eslint .",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@supernova/agent-runtime": "workspace:*",
    "@supernova/contracts": "workspace:*",
    "commander": "^14.0.2",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.1",
    "@types/ws": "8.18.1",
    "eslint": "^10.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
